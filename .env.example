# LLM_PROVIDER: gemini | anthropic
LLM_PROVIDER=
# LLM_MODEL: ej. gemini-3.8-flash o claude-sonnet-5
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MAX_ITERATIONS=25
MAX_TOKENS_SESSION=200000
# Tope global de tokens por día (contador en memoria; se reinicia con el servidor)
MAX_TOKENS_DIA=2000000
# Largo máximo del mensaje de la analista, en caracteres
MAX_CARACTERES_MENSAJE=4000
LLM_TIMEOUT_MS=60000
# Tope de tokens de salida por respuesta del modelo
LLM_MAX_TOKENS_RESPUESTA=2048
# LLM_ESFUERZO: bajo | medio | alto (razonamiento; se cobra como tokens de salida)
LLM_ESFUERZO=bajo
PORT=3000
MAX_TOKENS_DIA=2000000
MAX_CARACTERES_MENSAJE=2000